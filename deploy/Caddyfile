# The client's address (design §8, per-address limits): behind Cloudflare every request arrives from a Cloudflare
# address, so the real one is taken from CF-Connecting-IP, but only on requests from Cloudflare's ranges
# (https://www.cloudflare.com/ips/, 2026-11-09; update if Cloudflare adds ranges). A request from anywhere else keeps
# its own address, so the header cannot be forged by going around Cloudflare.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$PORTAL_DOMAIN:localhost} {
	encode zstd gzip

	# One address per claimset and per principal claim (design §7.1): people get the page, programs asking for JSON get
	# the published file (a claim: its bundle), reference managers asking for BibTeX get a claimset's entry. The .json,
	# .txt, .bib and .ris addresses stay explicit.
	@wants_json {
		path_regexp ^/p/[0-9]{4}\.[0-9]+(@v[0-9]+|/C[0-9]+)?$
		header Accept *application/json*
	}
	rewrite @wants_json {path}.json
	@wants_bibtex {
		path_regexp ^/p/[0-9]{4}\.[0-9]+(@v[0-9]+)?$
		header Accept *application/x-bibtex*
	}
	rewrite @wants_bibtex {path}.bib

	# An AI assistant given a claimset's page by a person gets the reading view, written for models, at the same
	# address: assistants often may not open the links they find in a page, so the .txt link alone does not reach
	# them. Known assistant fetchers (their user agents) get it as a plain web page (.read), since some fetch web
	# pages but not text files; any client asking for plain text or Markdown first gets the .txt. Search crawlers
	# (Googlebot, Bingbot) are not among them and get the page.
	@assistant {
		path_regexp ^/p/[0-9]{4}\.[0-9]+(@v[0-9]+)?$
		header_regexp User-Agent (?i)(ChatGPT-User|OAI-SearchBot|Claude-User|Claude-SearchBot|Perplexity-User|GoogleAgent-URLContext|Google-GeminiNotebook|Google-NotebookLM|MistralAI-User|DuckAssistBot|meta-externalfetcher|cohere-ai)
	}
	rewrite @assistant {path}.read.html
	@wants_text {
		path_regexp ^/p/[0-9]{4}\.[0-9]+(@v[0-9]+|/C[0-9]+)?$
		header_regexp Accept ^\s*text/(plain|markdown)
	}
	rewrite @wants_text {path}.txt

	# The website and the published files are static, written by the indexer (design §7.4): served from the published
	# directory without touching the app. The pages load only this site's styles, fonts, images and one script
	# (page.js, on claimset and specification pages); every value from a claimset in them is escaped.
	# Packaged files, in their claimset's folder (storage.py): never run (a sandbox, nothing loaded), images shown,
	# everything else downloaded. A published version's files never change. Before the pages: /p/* is theirs too.
	@claimset_files path_regexp ^/p/[0-9]{4}\.[0-9]+/v[0-9]+/files/
	handle @claimset_files {
		root * /srv/published
		@not_image not path_regexp (?i)\.(png|jpe?g|gif|webp|svg)$
		header @not_image Content-Disposition attachment
		header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@published path / /index.html /lab /about /agents /privacy /how-to-judge /before-you-submit /convert /convert/message.txt /all /feed.xml /site.css /page.js /claimset.css /spec /spec/* /skills /skills/* /study-planning /study-planning/* /fonts/* /p/* /index.jsonl /llms.txt /robots.txt /subfields.json /sitemap.xml /.well-known/security.txt /favicon.ico /favicon.svg /apple-touch-icon.png /icon-192.png /icon-512.png /site.webmanifest /og-card.png /indexnow.txt
	handle @published {
		root * /srv/published
		header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'"
		header /p/* Vary "Accept, User-Agent"
		# Every page names its reading view in a header too, which some fetching tools read when they skip the page.
		@page path_regexp ^/p/[0-9]{4}\.[0-9]+(@v[0-9]+|/C[0-9]+)?$
		header @page Link "<{path}.txt>; rel=\"alternate\"; type=\"text/plain\""
		@versioned path /site.css /page.js /claimset.css /fonts/fonts.css
		header @versioned Cache-Control "public, max-age=31536000, immutable"
		# Deferred, so that they replace the type file_server gives by the extension.
		@markdown path /spec/*.md /skills/*.md /study-planning/*.md
		@bibtex path *.bib
		@ris path *.ris
		header @markdown {
			Content-Type "text/plain; charset=utf-8"
			defer
		}
		header @bibtex {
			Content-Type "application/x-bibtex; charset=utf-8"
			defer
		}
		header @ris {
			Content-Type "application/x-research-info-systems; charset=utf-8"
			defer
		}
		header /fonts/* Cache-Control "public, max-age=604800"
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	# The site's own images (the ORCID icon, photos on the About page).
	handle /img/* {
		root * /srv/published
		header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
		header Cache-Control "public, max-age=86400"
		file_server
	}

	# A static address that does not exist (a mistyped claimset, a removed file): the site's own page, with search
	# and the way home, written by the indexer as /404.html. The app answers its own addresses the same way.
	handle_errors 404 {
		root * /srv/published
		rewrite * /404.html
		file_server
	}

	handle {
		# The app reads the client's address from X-Forwarded-For: give it exactly one, the one resolved above,
		# never a list a client could have started.
		reverse_proxy app:8000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
