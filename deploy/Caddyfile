{$PORTAL_DOMAIN:localhost} {
	encode zstd gzip

	# Published files are static: served from the published directory without touching the app.
	@published path /p/* /index.jsonl /llms.txt
	handle @published {
		root * /srv/published
		header X-Content-Type-Options nosniff
		# /p/<id> is the reading view as a minimal page (p/<id>.html): escaped text, no scripts, nothing loaded.
		header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
		try_files {path} {path}.html
		file_server
	}

	# Packaged files, stored by checksum: always downloads, never rendered (an SVG or HTML file cannot run here).
	handle /files/* {
		root * /srv/published
		header Content-Disposition attachment
		header Content-Security-Policy "default-src 'none'; sandbox"
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		reverse_proxy app:8000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
