# The client's address (design §8, per-address limits): behind Cloudflare every request arrives from a Cloudflare
# address, so the real one is taken from CF-Connecting-IP, but only on requests from Cloudflare's ranges
# (https://www.cloudflare.com/ips/, 2026-11-09; update if Cloudflare adds ranges). A request from anywhere else keeps
# its own address, so the header cannot be forged by going around Cloudflare.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$PORTAL_DOMAIN:localhost} {
	encode zstd gzip

	# One address per claimset (design §7.1): people get the page, programs asking for JSON get the published file,
	# reference managers asking for BibTeX get its entry. The .json, .txt, .bib and .ris addresses stay explicit.
	@wants_json {
		path_regexp ^/p/[0-9]{4}\.[0-9]+(@v[0-9]+)?$
		header Accept *application/json*
	}
	rewrite @wants_json {path}.json
	@wants_bibtex {
		path_regexp ^/p/[0-9]{4}\.[0-9]+(@v[0-9]+)?$
		header Accept *application/x-bibtex*
	}
	rewrite @wants_bibtex {path}.bib

	# The website and the published files are static, written by the indexer (design §7.4): served from the published
	# directory without touching the app. The pages carry no scripts and load only this site's styles, fonts and
	# images; every value from a claimset in them is escaped.
	@published path / /index.html /lab /about /agents /privacy /removal /all /feed.xml /site.css /claimset.css /spec /spec/* /fonts/* /p/* /index.jsonl /llms.txt
	handle @published {
		root * /srv/published
		header Content-Security-Policy "default-src 'none'; style-src 'self'; font-src 'self'; img-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'"
		header /p/* Vary Accept
		# Deferred, so that they replace the type file_server gives by the extension.
		@markdown path /spec/*.md
		@bibtex path *.bib
		@ris path *.ris
		header @markdown {
			Content-Type "text/plain; charset=utf-8"
			defer
		}
		header @bibtex {
			Content-Type "application/x-bibtex; charset=utf-8"
			defer
		}
		header @ris {
			Content-Type "application/x-research-info-systems; charset=utf-8"
			defer
		}
		header /fonts/* Cache-Control "public, max-age=604800"
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	# Images shown on the pages: links to packaged files, named with their type so they display (site.file_url_for).
	handle /img/* {
		root * /srv/published
		header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
		header Cache-Control "public, max-age=86400"
		file_server
	}

	# Packaged files, stored by checksum: always downloads, never rendered (an SVG or HTML file cannot run here).
	handle /files/* {
		root * /srv/published
		header Content-Disposition attachment
		header Content-Security-Policy "default-src 'none'; sandbox"
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		# The app reads the client's address from X-Forwarded-For: give it exactly one, the one resolved above,
		# never a list a client could have started.
		reverse_proxy app:8000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
