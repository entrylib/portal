# The client's address (design §8, per-address limits): behind Cloudflare every request arrives from a Cloudflare
# address, so the real one is taken from CF-Connecting-IP, but only on requests from Cloudflare's ranges
# (https://www.cloudflare.com/ips/, 2026-11-09; update if Cloudflare adds ranges). A request from anywhere else keeps
# its own address, so the header cannot be forged by going around Cloudflare.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$PORTAL_DOMAIN:localhost} {
	encode zstd gzip

	# Published files are static: served from the published directory without touching the app.
	@published path /p/* /index.jsonl /llms.txt
	handle @published {
		root * /srv/published
		header X-Content-Type-Options nosniff
		# /p/<id> is the reading view as a minimal page (p/<id>.html): escaped text, no scripts, nothing loaded.
		header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
		try_files {path} {path}.html
		file_server
	}

	# Packaged files, stored by checksum: always downloads, never rendered (an SVG or HTML file cannot run here).
	handle /files/* {
		root * /srv/published
		header Content-Disposition attachment
		header Content-Security-Policy "default-src 'none'; sandbox"
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		# The app reads the client's address from X-Forwarded-For: give it exactly one, the one resolved above,
		# never a list a client could have started.
		reverse_proxy app:8000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
